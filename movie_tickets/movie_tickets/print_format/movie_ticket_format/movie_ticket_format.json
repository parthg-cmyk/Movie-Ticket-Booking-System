    "font_size": 14,
    "html": "<style>\n    body {\n        font-family: 'Segoe UI', sans-serif;\n        background: #f4f4f4;\n    }\n\n    .ticket {\n        width: 700px;\n        margin: auto;\n        border-radius: 16px;\n        overflow: hidden;\n        background: #1e1e1e;\n        color: #fff;\n        box-shadow: 0 10px 25px rgba(0,0,0,0.25);\n    }\n\n    /* \ud83c\udfac HEADER */\n    .ticket-header {\n        background: linear-gradient(90deg, #ff416c, #ff4b2b);\n        padding: 20px;\n        text-align: center;\n    }\n\n    .movie-title {\n        font-size: 24px;\n        font-weight: bold;\n        margin-bottom: 5px;\n    }\n\n    .movie-sub {\n        font-size: 14px;\n        color: #ffecec;\n    }\n\n    /* \ud83c\udf9f BODY */\n    .ticket-body {\n        padding: 20px;\n        background: #2a2a2a;\n    }\n\n    .info-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        row-gap: 12px;\n        column-gap: 20px;\n    }\n\n    .label {\n        color: #bbbbbb;\n        font-size: 13px;\n    }\n\n    .value {\n        color: #bbbbbb;\n        font-weight: 600;\n        font-size: 14px;\n        text-align: right;\n    }\n\n    .divider {\n        border-top: 1px dashed #555;\n        margin: 15px 0;\n    }\n\n    /* \ud83c\udfaf FOOTER */\n    .footer {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 15px;\n        background: #000;\n    }\n\n    .amount {\n        font-size: 20px;\n        font-weight: bold;\n        color: #2ecc71;\n    }\n\n    .booking-id {\n        font-size: 12px;\n        color: #aaa;\n    }\n\n    .qr img {\n        width: 120px;\n        background: #fff;\n        padding: 6px;\n        border-radius: 8px;\n    }\n\n    .cinema-title {\n        text-align: center;\n        font-size: 12px;\n        padding: 8px;\n        background: #000;\n        color: #aaa;\n        letter-spacing: 2px;\n    }\n</style>\n\n<div class=\"ticket\">\n\n    <!-- \ud83c\udfac HEADER -->\n    <div class=\"ticket-header\">\n        <div class=\"movie-title\">{{ doc.movie_title }}</div>\n        <div class=\"movie-sub\">\n            {{ doc.theater }} | Screen {{ doc.screen }}\n        </div>\n        <div class=\"movie-sub\">\n            {{ doc.show_date }} {{ doc.start_time }}\n        </div>\n    </div>\n\n    <!-- \ud83c\udf9f BODY -->\n    <div class=\"ticket-body\">\n\n        <div class=\"info-grid\">\n\n            <div class=\"label\">Customer</div>\n            <div class=\"label\">{{ doc.customer_name }}</div>\n\n            <div class=\"label\">Seats</div>\n            <div class=\"label\">\n                {% for s in doc.seats %}\n                    {{ s.seat_label }}{% if not loop.last %}, {% endif %}\n                {% endfor %}\n            </div>\n\n            <div class=\"label\">Show</div>\n            <div class=\"label\">{{ doc.show }}</div>\n\n        </div>\n\n        <div class=\"divider\"></div>\n\n        <div class=\"info-grid\">\n\n            <div class=\"label\">Price per Seat</div>\n            <div class=\"label\">\u20b9{{ doc.price_per_seat }}</div>\n\n            <div class=\"label\">Total Seats</div>\n            <div class=\"label\">{{ doc.number_of_seats }}</div>\n\n        </div>\n\n    </div>\n\n    <!-- \ud83c\udfaf FOOTER -->\n    <div class=\"footer\">\n\n        <div>\n            <div class=\"amount\">\u20b9{{ doc.total_amount }}</div>\n            <div class=\"booking-id\">Booking ID: {{ doc.name }}</div>\n        </div>\n\n        <div class=\"qr\">\n            {% set qr_file = frappe.get_all(\"File\",\n                filters={\n                    \"attached_to_doctype\": doc.doctype,\n                    \"attached_to_name\": doc.name\n                },\n                fields=[\"file_url\"],\n                limit=1\n            ) %}\n            \n            {% if qr_file %}\n                <img src=\"{{ frappe.utils.get_url(qr_file[0].file_url) }}\">\n            {% endif %}\n        </div>\n\n    </div>\n\n    <div class=\"cinema-title\">\n        \ud83c\udfac MOVIE TICKETS \u2022 ENJOY YOUR SHOW\n    </div>\n\n</div>",
